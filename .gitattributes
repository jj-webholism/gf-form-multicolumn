# Auto-detect text files and normalise line endings to LF across operating systems
* text=auto eol=lf

# Explicit binary file declarations
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary

# Exclude development, testing, and CI tooling from distribution archives and git exports
/.github            export-ignore
/bin                export-ignore
/tests              export-ignore
/node_modules       export-ignore
/vendor             export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
.editorconfig       export-ignore
composer.json       export-ignore
composer.lock       export-ignore
package.json        export-ignore
package-lock.json   export-ignore
phpunit.xml         export-ignore
phpunit.xml.dist    export-ignore
phpstan.neon        export-ignore
run-tests.sh        export-ignore
playwright.config.* export-ignore
*.sha256            export-ignore
*.zip               export-ignore