<?xml version="1.0"?>
<ruleset name="GF-Multicolumn-Rules">
    <description>Rules for Gravity Forms Multicolumn Plugin</description>

    <!-- Scan these folders -->
    <file>./includes</file>

    <!-- Exclude Composer packages -->
    <exclude-pattern>/vendor/*</exclude-pattern>

    <!-- Check for PHP 8.0+ compatibility -->
    <config name="testVersion" value="8.0-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Enforce WordPress Security and Formatting -->
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>
</ruleset>