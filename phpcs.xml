<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for Gravity Forms Multicolumn">
    <description>Custom sniffs for Gravity Forms Multicolumn plugin.</description>

    <!-- Target files and directories to scan -->
    <file>gf-form-multicolumn.php</file>
    <file>includes</file>

    <!-- Only scan PHP files -->
    <arg name="extensions" value="php"/>

    <!-- CLI Output Options -->
    <arg value="sp"/>
    <arg name="basepath" value="./"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>

    <!-- Exclude third-party and built assets -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>

    <!-- PHP Version Compatibility Check: Enforce minimum declared PHP 7.3 up through PHP 8.3 -->
    <config name="testVersion" value="7.3-8.3"/>
    <rule ref="PHPCompatibilityWP"/>
    <!-- Ignore PHP false positive for /public/ folder name -->
    <rule ref="PHPCompatibility.Keywords.ForbiddenNames.publicFound">
        <severity>0</severity>
    </rule>

    <!-- WordPress Coding Standards -->
    <config name="minimum_supported_wp_version" value="6.4"/>
    <rule ref="WordPress"/>

    <!-- Disable Strict WordPress Class File Naming (Allows PSR-4 Autoloading) -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <severity>0</severity>
    </rule>

    <!-- Allow Multiple Namespace Declarations / Stubs (For Test Compatibility) -->
    <rule ref="Universal.Namespaces.DisallowCurlyBraceSyntax">
        <severity>0</severity>
    </rule>
    <rule ref="Universal.Namespaces.DisallowDeclarationWithoutName">
        <severity>0</severity>
    </rule>
    <rule ref="Universal.Namespaces.OneDeclarationPerFile">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <severity>0</severity>
    </rule>

    <!-- Allow Leading Underscores on Class Properties (Required by Gravity Forms AddOn Framework) -->
    <rule ref="PSR2.Classes.PropertyDeclaration.Underscore">
        <severity>0</severity>
    </rule>

    <!-- Ignore Short Prefix Warnings for "wh" Namespace -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed">
        <severity>0</severity>
    </rule>

    <!-- Ignore Legacy Constant Prefix Checks -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
        <severity>0</severity>
    </rule>

    <!-- Prefixing Rules for Globals, Functions, Classes -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="wh_gf_multicolumn"/>
                <element value="wh_gf"/>
                <element value="wh"/>
                <element value="gfmc"/>
            </property>
        </properties>
    </rule>

    <!-- Internationalization (i18n) Text Domain Check -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="gf-form-multicolumn"/>
            </property>
        </properties>
    </rule>

    <!-- Exclude NonPrefixedClassFound for third-party GFAddOn base class -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedClassFound">
        <severity>0</severity>
    </rule>

    <!-- Exclude procedural functions mixed with class loader in entry file -->
    <rule ref="Universal.Files.SeparateFunctionsFromOO">
        <exclude-pattern>gf-form-multicolumn.php</exclude-pattern>
    </rule>

    <!-- Exclude NonPrefixedClassFound for third-party GFAddOn base class -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedClassFound">
        <severity>0</severity>
    </rule>
</ruleset>