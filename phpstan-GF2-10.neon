includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - gf-form-multicolumn.php
        - includes/
    scanDirectories:
        - stubs/gf-2.10/
    excludePaths:
        - vendor/
    ignoreErrors:
        - identifier: function.alreadyNarrowedType
        - identifier: isset.offset
        - identifier: booleanAnd.rightAlwaysFalse